{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "vite/client"],
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "useDefineForClassFields": false,
        "noEmit": true
    },
    "include": ["src", "types", "test"]
}
